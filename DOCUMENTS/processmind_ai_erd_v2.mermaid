    string name
    string slug
    string color
    string entity_scope
    timestamp created_at
}

SOP_TAGS {
    uuid id PK
    uuid sop_id FK
    uuid tag_id FK
    uuid tagged_by FK
    timestamp tagged_at
}

WORKFLOW_TAGS {
    uuid id PK
    uuid workflow_id FK
    uuid tag_id FK
    uuid tagged_by FK
    timestamp tagged_at
}

%% ================================================================
%% SOP MANAGEMENT
%% ================================================================

SOP_CATEGORIES {
    uuid id PK
    uuid organization_id FK
    uuid parent_category_id FK
    string name
    string description
    string color
