    timestamp created_at
    timestamp updated_at
}

SOPS {
    uuid id PK
    uuid organization_id FK
    uuid category_id FK
    uuid created_by FK
    uuid owned_by FK
    string title
    string description
    string status
    string reference_code
    int current_version_number
    timestamp created_at
    timestamp updated_at
    timestamp deleted_at
}

SOP_VERSIONS {
    uuid id PK
    uuid sop_id FK
    uuid created_by FK
    int version_number
    string change_summary
    string status
    boolean is_published
    timestamp published_at
    timestamp created_at
}

UPLOADED_DOCUMENTS {
    uuid id PK
    uuid organization_id FK
    uuid sop_version_id FK
    uuid file_id FK
    uuid uploaded_by FK
    string status
    string processing_notes
    timestamp created_at
    timestamp deleted_at
}

%% ================================================================
%% AI ENGINE
%% ================================================================

AI_PROVIDERS {
    uuid id PK
    string name
    string api_base_url
    string auth_type
    boolean is_active
    jsonb capabilities
    timestamp created_at
    timestamp updated_at
}

AI_MODELS {
    uuid id PK
    uuid provider_id FK
    string model_name
    string model_version
    string task_type
    int context_window_tokens
    decimal input_cost_per_token
    decimal output_cost_per_token
    boolean is_active
    timestamp created_at
    timestamp updated_at
}

AI_MODEL_CONFIGS {
    uuid id PK
    uuid organization_id FK
    uuid model_id FK
    uuid created_by FK
    string config_name
    decimal temperature
    int max_tokens
    decimal top_p
    jsonb additional_params
    boolean is_default
    timestamp created_at
    timestamp updated_at
}

AI_PROMPT_TEMPLATES {
    uuid id PK
    uuid organization_id FK
    uuid created_by FK
    string name
    string description
    string task_type
    text system_prompt
    boolean is_active
    boolean is_global
    timestamp created_at
    timestamp updated_at
}

AI_PROMPT_VERSIONS {
    uuid id PK
    uuid template_id FK
    uuid created_by FK
    int version_number
    text user_prompt_template
    jsonb variables_schema
    boolean is_published
    timestamp created_at
}

AI_REQUESTS {
    uuid id PK
    uuid organization_id FK
    uuid model_id FK
    uuid model_config_id FK
    uuid prompt_version_id FK
    uuid initiated_by FK
    string entity_type
    uuid entity_id
    text input_prompt
    int input_tokens
    string status
    string request_hash
    timestamp created_at
    timestamp completed_at
}

AI_RESPONSES {
    uuid id PK
    uuid request_id FK
    text raw_response
    jsonb parsed_response
    int output_tokens
    int total_tokens
    decimal cost_usd
    int latency_ms
    boolean is_cached
    string finish_reason
    string error_code
    timestamp created_at
}

AI_ANALYSIS {
    uuid id PK
    uuid organization_id FK
    uuid sop_version_id FK
    uuid request_id FK
    uuid created_by FK
    string status
    jsonb extracted_steps
    jsonb extracted_roles
    jsonb extracted_conditions
    jsonb extracted_kpis
    decimal confidence_score
    string failure_reason
    timestamp created_at
    timestamp completed_at
}

AI_VALIDATION {
    uuid id PK
    uuid organization_id FK
    uuid workflow_version_id FK
    uuid request_id FK
    uuid initiated_by FK
    string status
    jsonb validation_results
    jsonb issues_found
    decimal completeness_score
    decimal consistency_score
    string failure_reason
    timestamp created_at
    timestamp completed_at
}

AI_SIMULATION {
    uuid id PK
    uuid organization_id FK
    uuid workflow_version_id FK
    uuid request_id FK
    uuid initiated_by FK
    string status
    jsonb simulation_parameters
    jsonb simulation_results
    jsonb bottlenecks_identified
    int simulated_duration_minutes
    timestamp created_at
    timestamp completed_at
}

AI_OPTIMIZATION {
    uuid id PK
    uuid organization_id FK
    uuid workflow_version_id FK
    uuid request_id FK
    uuid initiated_by FK
    string status
    jsonb optimization_suggestions
    decimal estimated_improvement_pct
    boolean is_applied
    uuid applied_by FK
    timestamp applied_at
    timestamp created_at
    timestamp completed_at
}

AI_RECOMMENDATIONS {
    uuid id PK
    uuid organization_id FK
    uuid request_id FK
    string source_entity_type
    uuid source_entity_id
    string recommendation_type
    string title
    text description
    jsonb recommended_changes
    decimal confidence_score
    string status
    uuid dismissed_by FK
    timestamp created_at
    timestamp dismissed_at
}

