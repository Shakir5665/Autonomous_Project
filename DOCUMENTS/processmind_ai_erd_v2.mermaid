%% ================================================================
%% RELATIONSHIPS
%% ================================================================

%% --- Auth Core ---
ORGANIZATIONS ||--o{ USERS : "has"
ORGANIZATIONS ||--o{ ROLES : "defines"
USERS ||--o{ USER_ROLES : "assigned"
ROLES ||--o{ USER_ROLES : "assigned to"
ROLES ||--o{ ROLE_PERMISSIONS : "grants"
PERMISSIONS ||--o{ ROLE_PERMISSIONS : "granted via"
USERS ||--o{ REFRESH_TOKENS : "holds"
USERS ||--o{ PASSWORD_RESET_TOKENS : "requests"
USERS ||--o{ SESSIONS : "opens"

%% --- Security ---
ORGANIZATIONS ||--o{ LOGIN_HISTORY : "scopes"
USERS ||--o{ LOGIN_HISTORY : "records"
ORGANIZATIONS ||--o{ API_KEYS : "owns"
USERS ||--o{ API_KEYS : "creates"
ORGANIZATIONS ||--o{ SECURITY_EVENTS : "logs"
USERS ||--o{ SECURITY_EVENTS : "triggers"

%% --- Organization Structure ---
ORGANIZATIONS ||--o{ DEPARTMENTS : "has"
DEPARTMENTS ||--o{ DEPARTMENTS : "has sub-departments"
DEPARTMENTS ||--o{ DEPARTMENT_MEMBERS : "has"
USERS ||--o{ DEPARTMENT_MEMBERS : "belongs to"
DEPARTMENTS ||--o{ TEAMS : "organizes"
ORGANIZATIONS ||--o{ TEAMS : "has"
TEAMS ||--o{ TEAM_MEMBERS : "has"
USERS ||--o{ TEAM_MEMBERS : "belongs to"
ORGANIZATIONS ||--o{ ORGANIZATION_SETTINGS : "configures"
USERS ||--o{ ORGANIZATION_SETTINGS : "updated by"

%% --- User Profiles ---
USERS ||--|| USER_PROFILES : "has"
USERS ||--o{ USER_PREFERENCES : "sets"

%% --- Tagging ---
ORGANIZATIONS ||--o{ TAGS : "owns"
SOPS ||--o{ SOP_TAGS : "tagged with"
TAGS ||--o{ SOP_TAGS : "applied to"
USERS ||--o{ SOP_TAGS : "tagged by"
WORKFLOWS ||--o{ WORKFLOW_TAGS : "tagged with"
TAGS ||--o{ WORKFLOW_TAGS : "applied to"
USERS ||--o{ WORKFLOW_TAGS : "tagged by"

%% --- SOP Management ---
ORGANIZATIONS ||--o{ SOP_CATEGORIES : "owns"
SOP_CATEGORIES ||--o{ SOP_CATEGORIES : "has sub-categories"
ORGANIZATIONS ||--o{ SOPS : "owns"
SOP_CATEGORIES ||--o{ SOPS : "classifies"
USERS ||--o{ SOPS : "creates"
SOPS ||--o{ SOP_VERSIONS : "has"
SOP_VERSIONS ||--o{ UPLOADED_DOCUMENTS : "contains"
FILE_STORAGE ||--o{ UPLOADED_DOCUMENTS : "stored as"

%% --- AI Engine ---
AI_PROVIDERS ||--o{ AI_MODELS : "offers"
AI_MODELS ||--o{ AI_MODEL_CONFIGS : "configured via"
ORGANIZATIONS ||--o{ AI_MODEL_CONFIGS : "owns"
USERS ||--o{ AI_MODEL_CONFIGS : "creates"
ORGANIZATIONS ||--o{ AI_PROMPT_TEMPLATES : "owns"
USERS ||--o{ AI_PROMPT_TEMPLATES : "creates"
AI_PROMPT_TEMPLATES ||--o{ AI_PROMPT_VERSIONS : "versioned as"
USERS ||--o{ AI_PROMPT_VERSIONS : "authors"
ORGANIZATIONS ||--o{ AI_REQUESTS : "initiates"
AI_MODELS ||--o{ AI_REQUESTS : "handles"
AI_MODEL_CONFIGS ||--o{ AI_REQUESTS : "configured by"
AI_PROMPT_VERSIONS ||--o{ AI_REQUESTS : "uses"
USERS ||--o{ AI_REQUESTS : "initiates"
AI_REQUESTS ||--o| AI_RESPONSES : "produces"
ORGANIZATIONS ||--o{ AI_ANALYSIS : "owns"
SOP_VERSIONS ||--o{ AI_ANALYSIS : "analyzed via"
AI_REQUESTS ||--o{ AI_ANALYSIS : "powers"
USERS ||--o{ AI_ANALYSIS : "requests"
ORGANIZATIONS ||--o{ AI_VALIDATION : "owns"
WORKFLOW_VERSIONS ||--o{ AI_VALIDATION : "validated by"
AI_REQUESTS ||--o{ AI_VALIDATION : "powers"
