erDiagram

%% ================================================================
%% AUTHENTICATION & SECURITY
%% ================================================================

USERS {
    uuid id PK
    uuid organization_id FK
    string email
    string password_hash
    string first_name
    string last_name
    string phone
    boolean is_active
    boolean is_verified
    boolean is_mfa_enabled
    string mfa_secret
    timestamp email_verified_at
    timestamp last_login_at
    timestamp created_at
    timestamp updated_at
    timestamp deleted_at
}

ROLES {
    uuid id PK
    uuid organization_id FK
    string name
    string slug
    string description
    boolean is_system_role
    boolean is_active
    timestamp created_at
    timestamp updated_at
}

PERMISSIONS {
    uuid id PK
    string module
    string resource
    string action
    string description
    boolean is_active
    timestamp created_at
}

USER_ROLES {
    uuid id PK
    uuid user_id FK
    uuid role_id FK
    uuid assigned_by FK
    timestamp assigned_at
    timestamp expires_at
}

ROLE_PERMISSIONS {
    uuid id PK
    uuid role_id FK
    uuid permission_id FK
    timestamp assigned_at
}

REFRESH_TOKENS {
    uuid id PK
    uuid user_id FK
    string token_hash
    string device_fingerprint
    string ip_address
    boolean is_revoked
    timestamp expires_at
    timestamp created_at
}

PASSWORD_RESET_TOKENS {
    uuid id PK
    uuid user_id FK
    string token_hash
    boolean is_used
    timestamp expires_at
    timestamp created_at
}

SESSIONS {
    uuid id PK
    uuid user_id FK
    string session_token_hash
    string ip_address
    string user_agent
    boolean is_active
    timestamp last_activity_at
    timestamp expires_at
    timestamp created_at
}

LOGIN_HISTORY {
    uuid id PK
    uuid organization_id FK
    uuid user_id FK
    string ip_address
    string user_agent
    string login_method
    boolean success
    string failure_reason
    timestamp created_at
}

API_KEYS {
    uuid id PK
    uuid organization_id FK
    uuid created_by FK
    string name
    string key_prefix
    string key_hash
    string scopes
    boolean is_active
    timestamp last_used_at
    timestamp expires_at
    timestamp created_at
    timestamp revoked_at
}

SECURITY_EVENTS {
    uuid id PK
    uuid organization_id FK
    uuid user_id FK
    string event_type
    string severity
    string description
    jsonb metadata
    string ip_address
    timestamp created_at
}

%% ================================================================
%% ORGANIZATION
%% ================================================================

ORGANIZATIONS {
    uuid id PK
    string name
    string slug
    string domain
    string industry
    string country
    string timezone
    string logo_url
    string status
    timestamp trial_ends_at
    timestamp created_at
    timestamp updated_at
    timestamp deleted_at
}

DEPARTMENTS {
    uuid id PK
    uuid organization_id FK
    uuid parent_department_id FK
    uuid manager_id FK
    string name
    string description
    boolean is_active
    timestamp created_at
    timestamp updated_at
}

DEPARTMENT_MEMBERS {
    uuid id PK
    uuid department_id FK
    uuid user_id FK
    string membership_type
    boolean is_primary
    timestamp joined_at
    timestamp left_at
}

TEAMS {
    uuid id PK
    uuid organization_id FK
    uuid department_id FK
    uuid team_lead_id FK
    string name
    string description
    boolean is_active
    timestamp created_at
    timestamp updated_at
}

TEAM_MEMBERS {
    uuid id PK
    uuid team_id FK
    uuid user_id FK
    string role
    timestamp joined_at
    timestamp left_at
}

ORGANIZATION_SETTINGS {
    uuid id PK
    uuid organization_id FK
    uuid updated_by FK
    string setting_key
    text setting_value
    string data_type
    timestamp updated_at
}

%% ================================================================
